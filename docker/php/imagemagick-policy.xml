<policymap>
    <policy domain="resource" name="memory" value="256MiB" />
    <policy domain="resource" name="map" value="256MiB" />
    <policy domain="resource" name="disk" value="256MiB" />
    <policy domain="resource" name="width" value="40KP" />
    <policy domain="resource" name="height" value="40KP" />
    <policy domain="resource" name="area" value="40MP" />
    <policy domain="resource" name="list-length" value="16" />
    <policy domain="resource" name="thread" value="1" />
    <policy domain="resource" name="time" value="45" />
    <policy domain="delegate" rights="none" pattern="*" />
    <policy domain="filter" rights="none" pattern="*" />
    <policy domain="path" rights="none" pattern="@*" />
    <policy domain="coder" rights="none" pattern="*" />
    <policy domain="coder" rights="read|write" pattern="{JPEG,PNG,WEBP,HEIC,HEIF}" />
</policymap>
