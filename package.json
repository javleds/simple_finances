{
    "name": "fin-si",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "run-p type-check \"build-only {@}\" --",
        "preview": "vite preview",
        "test:unit": "vitest",
        "build-only": "vite build",
        "type-check": "vue-tsc --build",
        "lint": "run-s lint:*",
        "lint:oxlint": "oxlint resources/js --fix",
        "lint:eslint": "eslint resources/js --fix --cache",
        "format": "prettier --write resources/js/",
        "pw:views": "node scripts/playwright/captureFacilities.mjs --output-dir tmp/playwright-views",
        "pw:views:list": "node scripts/playwright/captureFacilities.mjs --list",
        "pw:facilities": "node scripts/playwright/captureFacilities.mjs",
        "pw:facilities:list": "node scripts/playwright/captureFacilities.mjs --list",
        "pw:categories": "node scripts/playwright/verifyCategories.mjs",
        "pw:mobile-design": "node scripts/playwright/verifyMobileDesign.mjs"
    },
    "dependencies": {
        "@heroicons/vue": "^2.2.0",
        "@primeui/chart-style": "^1.2.0",
        "@primeui/vue-chart": "^1.2.0",
        "@primeuix/themes": "^3.0.1",
        "@primevue/forms": "^5.0.2",
        "@tailwindcss/vite": "^4.2.4",
        "@tanstack/vue-query": "^5.101.2",
        "pinia": "^3.0.4",
        "primevue": "^5.0.2",
        "tailwindcss": "^4.2.4",
        "tailwindcss-primeui": "^0.6.1",
        "vue": "^3.5.32",
        "vue-router": "^5.0.4",
        "zod": "^4.4.2"
    },
    "devDependencies": {
        "@tsconfig/node24": "^24.0.4",
        "@types/jsdom": "^28.0.1",
        "@types/node": "^24.12.2",
        "@vitejs/plugin-vue": "^6.0.6",
        "@vitest/eslint-plugin": "^1.6.16",
        "@vue/eslint-config-typescript": "^14.7.0",
        "@vue/test-utils": "^2.4.6",
        "@vue/tsconfig": "^0.9.1",
        "concurrently": "^9.2.1",
        "eslint": "^10.2.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-oxlint": "~1.60.0",
        "eslint-plugin-vue": "~10.8.0",
        "jiti": "^2.6.1",
        "jsdom": "^29.0.2",
        "laravel-vite-plugin": "^3.2.0",
        "npm-run-all2": "^8.0.4",
        "oxlint": "~1.60.0",
        "playwright": "^1.61.1",
        "prettier": "^3.8.3",
        "prettier-plugin-tailwindcss": "^0.8.0",
        "typescript": "~6.0.0",
        "vite": "^8.0.8",
        "vite-plugin-vue-devtools": "^8.1.1",
        "vitest": "^4.1.4",
        "vue-tsc": "^3.2.6"
    },
    "engines": {
        "node": "^24.0.0"
    }
